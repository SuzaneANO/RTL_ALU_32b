`define CMD_NOOP 2'b00
`define CMD_ADD  2'b01
`define CMD_SUB  2'b10
`define CMD_MULT 2'b11

`define ARRAY_SEL0 2'b00
`define ARRAY_SEL1 2'b01
`define ARRAY_SEL2 2'b10
`define ARRAY_NONE 2'b11

